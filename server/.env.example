DATABASE_URL=postgres://clone_app:clone_app@localhost:5433/clone
MIGRATION_DATABASE_URL=postgres://clone:clone@localhost:5433/clone
PORT=8000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Task -> model routing. Call sites pass a Task, never a model id. ---
# W1 default is all-Anthropic: those prices are VERIFIED (platform.claude.com,
# 2026-09-07) so the app boots and you can talk to your clone today.
#
# BEFORE BETA, flip chat + extract to OpenAI. Not a cost decision - the Anthropic
# AUP prohibits erotic/sexual content with "we may throttle, suspend, or terminate
# your access", and raw user chat in a dating-adjacent clone will contain it. After
# the flip Anthropic sees only structured fact payloads. That flip is one line here,
# which is the seam doing its job.
CHAT_MODEL=anthropic:claude-sonnet-5
EXTRACT_MODEL=anthropic:claude-sonnet-5
RESOLVE_MODEL=anthropic:claude-sonnet-5
REFLECT_MODEL=anthropic:claude-sonnet-5
RENDER_PROFILE_MODEL=anthropic:claude-sonnet-5
CANON_MODEL=anthropic:claude-sonnet-5

EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=1

# Refuse to boot if a routed model has no verified price in src/llm/caps.ts.
# A fresh app install provisions its own account, with no invite and no rate limit
# before it. Production refuses to start with this true.
#
# Turned off 2026-09-14 and the app does not notice: `provisionDevice` in
# app/src/lib/api.ts has no callers left -- the client already sends a device with no
# credential to the invite screen. It stays exported, and unused, as the escape hatch
# for a machine that cannot be handed a code.
ALLOW_DEVICE_SIGNUP=false

# Verified against the vendor's own pricing page, with a date, in src/llm/caps.ts.
# The server refuses to boot on a routed model whose price is unverified -- which is
# the point. This was `true` in a running config for long enough that every cost
# figure the project quoted rested on numbers nothing had checked. Leave it false.
ALLOW_UNVERIFIED_PRICING=false

# Whether an invented profile answers "yes" on behalf of its non-existent human.
#
# OFF. With it on, a real person who says yes to a practice profile is introduced to
# it and dropped into a conversation nobody will ever answer. Production refuses to
# start with this true. Turn it on locally only to walk the messaging flow by hand.
SYNTHETIC_AUTO_YES=false

# Enforced in-process BEFORE every call. One looping tenant overnight is the
# realistic catastrophe for an unfunded solo dev, not a dropped cache breakpoint.
DAILY_COST_CAP_USD=2.00
TRIAL_TURN_CAP_PER_DAY=10
MAX_SESSION_OUTPUT_TOKENS=60000

# Who may read reports and hide photographs. A comma-separated list of user ids.
#
# Deliberately not a column on app_users: a database flag can be set by anything that
# can write to the database, whereas this needs shell access to the machine. Empty
# means nobody, every /v1/admin route 404s, and the server says so at boot -- because
# a report button whose rows nobody reads is worse than no report button.
ADMIN_USER_IDS=

# The model that judges a rendezvous, when it should not be the one that wrote it.
# Empty means the same model as the prober -- which measured 79.3% agreement across 47
# pairs against a 50% pass mark, i.e. one model agreeing with itself. Set it to a model
# from another family to find out how much of that was the two people.
ASSESS_MODEL=

# --- Required. No defaults, because a default here is a guard that never fires. ---
#
# NODE_ENV decides whether six boot refusals run at all. It used to default to
# "development", and nothing in this repo ever sets it, so on a real host every one of
# those checks was skipped silently. Unset now refuses to boot.
NODE_ENV=development

# The token signing key. Was defaulted to a literal in this repository.
#   openssl rand -base64 48
AUTH_SECRET=

# The pepper for hashed phone numbers. Derived from AUTH_SECRET when unset, which is
# fine on a laptop and refused in production: a derived pepper is only as good as what
# it is derived from, and it ties two rotations together that must stay separate.
# Rotating AUTH_SECRET signs everyone out. Rotating THIS detaches every account from
# its phone number, permanently.
#   openssl rand -base64 48
PHONE_PEPPER=

# --- Texts ---
# console writes the code to this log and sends nothing. Production refuses it.
SMS_PROVIDER=console
# Returns the one-time code in the HTTP response. Turns the feature off, basically.
# Handy on a laptop with no SMS account. Production refuses it.
SMS_DEV_ECHO=false
# Countries we will pay to send to. Without an allowlist, SMS pumping fraud.
SMS_COUNTRIES=+91,+1,+44
# A ceiling that does not care who is asking, under the per-IP and per-number limits.
SMS_DAILY_CAP=500
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# How many proxies sit in front of this server. 0 means none, so x-forwarded-for is
# ignored entirely and the socket's peer address is used. Above zero counts hops from
# the RIGHT of that header. Getting this wrong makes every per-IP limit useless.
TRUSTED_PROXY_HOPS=0

# The phone door (sign-in) and background discovery, each its own narrow role (0066).
# Never the owner: a superuser ignores every grant and policy. Production refuses to
# start without them. Dev passwords are the role names; ROTATION.md section 3.
DOOR_DATABASE_URL=postgres://clone_door:clone_door@localhost:5433/clone
DISCOVERY_DATABASE_URL=postgres://clone_discovery:clone_discovery@localhost:5433/clone
